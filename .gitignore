# Environment / secrets — never commit real values, only .env.example
.env
.env.*
!.env.example

# Local SQLite database
db.sqlite3
db.sqlite3-journal

# Build artifacts — regenerated by build.sh on every Render deploy
staticfiles/

# Python
__pycache__/
*.pyc
*.pyo
.Python

# Virtual environments
venv/
env/
.venv/

# Editor/OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db

# Never commit database copies, data dumps, logs or build archives — they
# contain customer data and (build.zip) secrets.
db.sqlite3.backup-*
*.sqlite3.backup*
data*.json
sqlite_data.json
*.log
build.zip
*.zip
cart_notif_test_out.txt

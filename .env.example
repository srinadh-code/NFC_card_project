VITE_API_BASE_URL=http://localhost:8000/api

# Google Sign-In — the OAuth Client ID from Google Cloud Console (same one
# the backend has as GOOGLE_OAUTH_CLIENT_ID). This is a public identifier,
# not a secret — it's meant to ship in the frontend bundle. Never put the
# Client Secret here or anywhere in frontend code.
VITE_GOOGLE_CLIENT_ID=

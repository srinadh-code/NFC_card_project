# Django
SECRET_KEY=change-me-to-a-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave unset to use local SQLite (dev default).
# For Postgres in production:
# DATABASE_URL=postgres://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
DATABASE_URL=

# Production-only security (all safely no-op while DEBUG=True locally).
# SECURE_SSL_REDIRECT defaults to True whenever DEBUG=False — only set this
# to False if a DEBUG=False deploy is briefly not yet behind HTTPS.
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS defaults to CORS_ALLOWED_ORIGINS (plus the Render
# hostname, auto-detected via RENDER_EXTERNAL_HOSTNAME) if left unset.
CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Cloudinary — required. This project has no local media storage at all:
# every uploaded image (profile avatars/covers, QR codes, and every Website
# Content image) goes to Cloudinary exclusively, with no fallback. Get
# these from your Cloudinary dashboard; leaving them blank doesn't fall
# back to local disk, it makes every upload fail with a clear error.
#
# Option 1 — the single URL from Cloudinary's dashboard:
CLOUDINARY_URL=
# Option 2 — the same credentials as three separate values instead
# (used only if CLOUDINARY_URL above is left blank):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email. Leave EMAIL_HOST unset to use the console backend (prints emails to
# the server log) which is fine for local development.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@vrsnexora.com

# Frontend
# List every origin Vite might actually serve on — it auto-bumps to
# 5174/5175/... whenever port 5173 is already taken (a stray dev server, a
# second terminal, etc.), and a missing origin here gets silently
# CORS-blocked rather than erroring clearly.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Google OAuth (leave blank to keep the /api/auth/google/ endpoint disabled)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Brevo (sends the forgot-password OTP by email — see accounts/emails.py's
# send_password_reset_otp_email). Leave BREVO_API_KEY blank for local dev:
# sending is skipped with a clear server-log warning instead of pretending
# to succeed. Swap in a company-owned Brevo account later by changing only
# these three values — no code change required.
BREVO_API_KEY=
# Falls back to DEFAULT_FROM_EMAIL above if left blank.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=